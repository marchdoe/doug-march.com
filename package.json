{
  "name": "dougmarch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "imports": {
    "#/*": "./app/*"
  },
  "scripts": {
    "dev": "panda codegen && vite",
    "build": "panda codegen && node scripts/generate-archive-json.js && vite build",
    "preview": "vite preview",
    "test": "panda codegen && vitest run",
    "test:e2e:site": "playwright test --project=site-health",
    "test:e2e:dev": "playwright test --project=dev-panel",
    "test:e2e": "playwright test",
    "codegen": "panda codegen",
    "codegen:watch": "panda codegen --watch",
    "pipeline": "MOCK_MODE=true node scripts/run-pipeline.js",
    "pipeline:dry": "MOCK_MODE=true DRY_RUN=true node scripts/run-pipeline.js",
    "pipeline:collect": "node scripts/collect-signals.js",
    "pipeline:interpret": "MOCK_MODE=true node scripts/interpret-signals.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/start-api-routes": "^1.120.19",
    "@vercel/functions": "^3.7.7",
    "js-yaml": "^4.3.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@pandacss/dev": "^1.12.0",
    "@playwright/test": "^1.62.1",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
