signals/today.mockup.html
signals/cli-diag-*.txt
signals/*-last-failed.txt

# Failed/interim build dirs from local pipeline runs — CI's push step already
# excludes these; this covers a local `git add -A`
archive/*/build-failed-*
archive/*/build-pre-*

# The raw built site the pipeline captures before sealing. public/archive/ is
# the sealed copy the site serves, and it was being committed a second time
# here, about 400 KB a night (#278). The pipeline still writes these so the
# seal step has something to copy; they just do not get tracked.
archive/*/build-*/site/
archive/*/site/

public/_proto-*/

references/*.png
# The nightly promotes the owner's own A/B-graded screenshot here; it must survive the runner, not just the collected references (#340).
!references/own-*.png
references/*.jpg
references/*.jpeg

# Generated archive JSON (projected from archive/*/record.json at build time).
# The screenshots and viewport captures beside it are pipeline output and ARE
# committed — nothing at build time can recreate them.
public/archive-data/*.json

# Build/pipeline artifacts
test-results/
.vercel

# Coverage output (vitest --coverage)
coverage/

# fallow's analysis cache
.fallow/
