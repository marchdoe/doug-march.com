{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "./node_modules/fallow/schema.json",

  // The nightly commits a full built site per day under archive/ and a copy of
  // the same pages under public/archive/. Together they are 2,693 of the 3,042
  // files fallow would otherwise walk, and every one of them is bundler output
  // — dead code in a snapshot of 2026-04-14 is not a finding anyone can act on.
  "ignorePatterns": ["archive/**", "public/**", ".superpowers/**", "app/routeTree.gen.ts"],

  // Roots nothing imports but everything runs: the nightly's scripts, the
  // signal collectors it discovers by directory listing, the chassis catalogue
  // design-agents.js loads by name, and the test files.
  //
  // Plus five roots fallow cannot infer. app/client.tsx, app/router.tsx and
  // app/ssr.tsx are TanStack Start's convention entries — the framework loads
  // them by path, so nothing imports them by name. app/dev-panel.html is a
  // Vite HTML entry, and the whole dev panel hangs off it (dev-entry →
  // dev-panel → dev/api, components/responsive-card). app/dev-responsive.html
  // is the same pattern for /dev/responsive (#328): dev-responsive-entry →
  // dev-responsive-page, served by app/dev-server/index.ts instead of the
  // router so the page's chunk never reaches a production build. Without
  // these, live files read as dead, which is most of what an "unused files"
  // count would be reporting.
  "entry": [
    "scripts/*.js",
    "scripts/signals/*.js",
    "scripts/utils/*.js",
    "elements/chassis/*.js",
    "tests/**/*.test.*",
    "tests/**/*.spec.*",
    "app/client.tsx",
    "app/router.tsx",
    "app/ssr.tsx",
    "app/dev-entry.tsx",
    "app/dev-responsive-entry.tsx",
    "app/stubs/*.ts"
  ],

  "health": {
    // A vitest file is one `describe` arrow wrapping every case in it, so the
    // unit-size rule reports the suite itself as a 100-line function on every
    // test file that grows. Kept visible under a raised ceiling rather than
    // ignored, so a genuinely unwieldy helper inside a test still surfaces.
    "thresholdOverrides": [
      {
        // Named debt, not a loosened rule. These three predate the gate and
        // sit in files any pipeline change has to touch, so without an entry
        // here the gate fails PRs for code they did not write. callClaudeCLI
        // and resultPromise are two of the functions #221 exists to split;
        // when that lands, this entry goes with them. Anything NEW crossing
        // the ceiling in these files still fails.
        "files": ["scripts/utils/claude-cli.js", "scripts/utils/token-gate.js"],
        "maxUnitSize": 400,
        "maxCyclomatic": 40,
        "maxCognitive": 60,
        "maxCrap": 500,
        "reason": "pre-existing; callClaudeCLI/resultPromise are #221's split targets"
      },
      {
        "files": ["tests/**"],
        "maxUnitSize": 250,
        "maxCyclomatic": 30,
        "maxCognitive": 30,
        "reason": "a describe block is a file, not a function"
      },
      {
        // The React Engineer's route pages and components have no unit
        // tests by design (#432) — the build, the surface gate and the
        // screenshot critic exercise them instead. With zero coverage,
        // CRAP collapses to cyclomatic² + cyclomatic, so a function sitting
        // right at the repo's cyclomatic ceiling of 20 scores 420 and fails
        // on branch count alone before cyclomatic or cognitive ever get a
        // say. maxCrap here clears that (420 plus headroom) so these paths
        // are judged the same way as the rest of the repo: on cyclomatic
        // and cognitive complexity. Those two ceilings are repeated at
        // their repo defaults, unchanged — a route page that actually earns
        // cyclomatic 21 or cognitive 16 still fails.
        "files": ["app/routes/**", "app/components/**"],
        "maxCyclomatic": 20,
        "maxCognitive": 15,
        "maxCrap": 450,
        "reason": "generated UI has no unit tests by design; judge on cyclomatic/cognitive, not zero-coverage CRAP"
      }
    ]
  },

  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  }
}
